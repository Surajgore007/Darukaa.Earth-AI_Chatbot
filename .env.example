# ==============================================================================
# Darukaa.Earth Biodiversity Intelligence Chatbot — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Google Gemini Model Identifiers (Verified September 2026)
# Generation model: 'gemini-2.5-flash' (recommended GA), fallback 'gemini-1.5-flash'
GEMINI_MODEL=gemini-2.5-flash

# Embedding model: 'gemini-embedding-001' (active replacement for retired text-embedding-004)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase PostgreSQL Database URL (with pgvector extension)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
